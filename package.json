{
  "name": "dsh-attention-health",
  "version": "0.1.3",
  "description": "DeepSeek Harness 长会话守卫：检测思考循环和输出复读，按本地日志建议何时交接，并生成无需额外模型调用的交接文档",
  "type": "module",
  "license": "MIT",
  "author": "东寒云浪",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/donghangxunlang-cmd/dsh-attention-health.git"
  },
  "homepage": "https://github.com/donghangxunlang-cmd/dsh-attention-health#readme",
  "bugs": {
    "url": "https://github.com/donghangxunlang-cmd/dsh-attention-health/issues"
  },
  "main": "lib/index.js",
  "bin": {
    "attention-health-handoff": "./handoff.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "handoff.mjs",
    "cordis.patch.yml",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "dsh": {
    "seams": [
      "fs",
      "web"
    ],
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dshReleases": {
        "0.1.5-rc.2": "compatible",
        "0.1.5-rc.3": "compatible"
      }
    }
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "plugin",
    "context",
    "session-health",
    "reasoning-loop",
    "repetition-guard",
    "handoff",
    "session-handoff",
    "projection"
  ]
}
