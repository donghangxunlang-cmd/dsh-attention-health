{
  "name": "dsh-attention-health",
  "version": "0.1.0",
  "description": "上下文健康监测 + 内容退化守卫 + 零模型交接文档（host + web UI 双面）",
  "type": "module",
  "license": "MIT",
  "author": "东寒云浪",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/donghangxunlang-cmd/dsh-attention-health.git"
  },
  "homepage": "https://github.com/donghangxunlang-cmd/dsh-attention-health#readme",
  "bugs": {
    "url": "https://github.com/donghangxunlang-cmd/dsh-attention-health/issues"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "handoff.mjs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dshReleases": {
        "0.1.5-rc.2": "compatible"
      }
    }
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "context",
    "handoff",
    "projection"
  ]
}
